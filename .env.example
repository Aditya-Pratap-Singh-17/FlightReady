# Gemini free-tier setup: obtain a key from https://aistudio.google.com/apikey
# Availability/quotas depend on your Google project; use a free-tier project.
# Leave GEMINI_API_KEY empty for offline fallback, or set CONTEXT_PROVIDER=deterministic.
CONTEXT_PROVIDER=deterministic
GEMINI_API_KEY=
CONTEXT_MODEL=gemini-2.5-flash-lite
# Legacy alternative: set CONTEXT_PROVIDER=openai-compatible and configure below.
CONTEXT_API_URL=https://api.openai.com/v1/chat/completions
CONTEXT_API_KEY=
MAX_UPLOAD_MB=2048
MAX_IMAGE_UPLOAD_MB=2048
# Larger tabular files use a local database; these settings bound working batches.
LARGE_DATASET_THRESHOLD_MB=16
DATASET_MEMORY_MB=256
MAX_ZIP_MB=4096
MAX_ZIP_FILES=50000
MAX_ANNOTATED_OBJECTS=1000000
MAX_NEAR_DUPLICATE_IMAGES=2000
MAX_XLSX_MB=256
NEAR_DUPLICATE_DISTANCE=0

# Persistent local research metadata, source snapshots, caches and model artifacts.
WORKBENCH_ROOT=.runtime/workbench

# Temporary weighted quality summary. Does not change requirement-based readiness.
EXPERIMENTAL_DATASET_SCORE_ENABLED=true
# Optional alternative config path; default is config/experimental_score.json.
EXPERIMENTAL_DATASET_SCORE_CONFIG=
